  "deviations": [
    { "id": "natural-regen", "title": "Tự hồi HP/MP 2% mỗi 5 s", "why": "Người dùng yêu cầu hồi theo thời gian; bản gốc chỉ hồi bằng thức ăn / thuốc / trang bị.", "how": "PlayerEffects.NaturalRegenPercent = 0 để giống gốc." },
    { "id": "skip-steps", "title": "Bỏ qua bước nhiệm vụ chưa port", "why": "Hang động, hộ tống Jaian, câu cá, xách nước, hằng ngày, bạn bè, nâng cấp, chiến trường chưa có.", "how": "Menu 'Bỏ qua: <bước>' ở NPC giao nhiệm vụ." },
    { "id": "generic-talk", "title": "Bước 'nói chuyện' ở NPC chưa port menu", "why": "Để chuỗi nhiệm vụ không bị kẹt.", "how": "Mục menu tên theo bước, bấm là qua bước." },
    { "id": "no-luong", "title": "Không có lượng", "why": "Bản offline không nạp tiền.", "how": "" },
    { "id": "auto-login", "title": "Tự đăng nhập 1 tài khoản cục bộ", "why": "Offline.", "how": "2 test đăng nhập sai mật khẩu / tên sai luôn fail (dự kiến)." }
  ],

