  "constraints": [
    { "id": "weapon-required", "area": "Chiến đấu", "rule": "Phải mặc vũ khí phù hợp với trường mới đánh được (trừ chưa vào trường dùng kiếm gỗ)", "message": "Vũ khí không thích hợp", "where": "PlayerCombat.AttackMonster" },
    { "id": "skill-cooldown", "area": "Chiến đấu", "rule": "Đòn đánh bị bỏ qua nếu chưa hết thời gian hồi chiêu (skill.cooldown, ms)", "where": "PlayerCombat.AttackMonster" },
    { "id": "skill-mana", "area": "Chiến đấu", "rule": "Không đủ MP thì không ra chiêu", "message": "Không đủ MP để sử dụng", "where": "PlayerCombat.AttackMonster" },
    { "id": "miss", "area": "Chiến đấu", "rule": "Né: random(mob.level+10) so với random(exactly+100); chí mạng: fatal > random(1000)", "where": "PlayerCombat.AttackMonster" },
    { "id": "kakyuu", "area": "Chiến đấu", "rule": "Kakyuu (skill tpl 4) chỉ nướng quái khi đủ điều kiện, nếu không báo", "message": "Đối phương quá mạnh bạn không thể thi triển thuật này!", "where": "PlayerCombat.Hit" },
    { "id": "effect-chance", "area": "Chiến đấu", "rule": "Bỏng 7/16: 4 s; băng 25/34: 3 s; choáng 43: 2 s; trói 24 và vô hiệu 40: param giây; skill lửa/băng/gió: 2/2/1 s, tỷ lệ = param0 %", "where": "PlayerCombat.Hit" },
    { "id": "buy-needs-task3", "area": "Cửa hàng", "rule": "Chỉ mua được khi đã qua NV diệt sên trừ cóc (taskId >= 3)", "message": "Hãy hoàn nhiệm vụ diệt trừ cóc để sử dụng chức năng này.", "where": "PlayerItems.BuyItem" },
    { "id": "no-luong", "area": "Cửa hàng", "rule": "Đồ giá lượng không mua được", "message": "Vật phẩm cần lượng, bản offline không có lượng.", "where": "PlayerItems.BuyItem" },
    { "id": "money", "area": "Cửa hàng", "rule": "Không đủ xu / yên thì không mua; yên tối đa 2.000.000.000", "message": "Không đủ tiền.", "where": "PlayerItems.BuyItem, AddYen" },
    { "id": "bag-full", "area": "Vật phẩm", "rule": "Hết chỗ trong hành trang: không nhận / mua / trả nhiệm vụ cần chỗ", "message": "Hành trang không đủ chỗ trống", "where": "PlayerItems, PlayerTasks.FinishTask" },
    { "id": "equip-level", "area": "Vật phẩm", "rule": "Dùng / mặc đồ cần level >= level của đồ", "where": "PlayerItems.UseItem" },
    { "id": "hp-full", "area": "Vật phẩm", "rule": "Không dùng thuốc khi HP/MP đã đầy", "message": "HP đã đầy. / MP đã đầy.", "where": "PlayerItems.UseItem" },
    { "id": "book-class", "area": "Kỹ năng", "rule": "Sách võ công phải đúng trường và chưa học", "message": "Sách này không đúng với trường bạn! / Chiêu này đã học!", "where": "PlayerSkills.LearnSkill" },
    { "id": "skill-level", "area": "Kỹ năng", "rule": "Cộng điểm kỹ năng cần đủ level của điểm tiếp theo (skill.level) và có điểm kỹ năng", "message": "Trình độ không đủ yêu cầu. / Bạn không đủ điểm.", "where": "PlayerSkills.UpSkill" },
    { "id": "drop-owner", "area": "Rơi đồ", "rule": "Đồ rơi thuộc người giết trong 20 s đầu, biến mất sau 30 s", "message": "Vật phẩm của người khác", "where": "PlayerItems.PickItem, UpdateItemMaps" },
    { "id": "drop-rates", "area": "Rơi đồ", "rule": "VP nhiệm vụ 1/3 (heo rừng luôn rơi rìu); boss không rơi đồ thường; chênh lệch level > 7 không rơi; 10% yên, 10% vật phẩm, 5% trang bị trong khoảng ±7 level", "where": "PlayerItems.OnMobDead" },
    { "id": "quest-npc", "area": "Nhiệm vụ", "rule": "Mỗi bước có NPC riêng (task.npcs[index+1]); -1 = thầy/cô của trường; NPC phải đứng trong khu hiện tại", "message": "Không tìm thấy NPC này", "where": "PlayerTasks.TaskNpcId, HasNpc" },
    { "id": "quest-skip", "area": "Nhiệm vụ", "rule": "Bước chưa port được cơ chế (status skip trong quests) có mục 'Bỏ qua: <bước>' ở NPC giao nhiệm vụ", "where": "PlayerTasks.InitMenu, IsStepSupported" },
    { "id": "quiz", "area": "Nhiệm vụ", "rule": "Câu đố: trả lời đúng đủ 5 câu thì qua 5 bước; sai thì hỏi lại", "where": "PlayerTasks.QuestionAndAnswer, Answer" },
    { "id": "admission", "area": "Nhiệm vụ", "rule": "Nhập học ở thầy/cô (cần NV tìm hiểu 3 trường); nhận vũ khí và sách của trường", "where": "PlayerTasks.Admission" },
    { "id": "mp-min", "area": "Chỉ số", "rule": "MP tối đa không dưới 100 (giá trị Java cho nhân vật mới)", "where": "PlayerCombat.SetAbility" }
  ],

