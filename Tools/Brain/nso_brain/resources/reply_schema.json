{
  "type": "json_schema",
  "json_schema": {
    "name": "nso_agent_advice",
    "strict": true,
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "say",
        "fleeHp",
        "priorities",
        "steps"
      ],
      "properties": {
        "reason": {
          "type": "string",
          "maxLength": 200
        },
        "say": {
          "type": "string",
          "maxLength": 80
        },
        "fleeHp": {
          "type": "integer",
          "minimum": 10,
          "maximum": 60
        },
        "priorities": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "quest": {
              "type": "number",
              "minimum": 0,
              "maximum": 3
            },
            "hunt": {
              "type": "number",
              "minimum": 0,
              "maximum": 3
            },
            "shop": {
              "type": "number",
              "minimum": 0,
              "maximum": 3
            },
            "explore": {
              "type": "number",
              "minimum": 0,
              "maximum": 3
            },
            "collect": {
              "type": "number",
              "minimum": 0,
              "maximum": 3
            },
            "idle": {
              "type": "number",
              "minimum": 0,
              "maximum": 3
            }
          },
          "required": [
            "quest",
            "hunt",
            "shop",
            "explore",
            "collect",
            "idle"
          ]
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "goal": {
                "type": "string",
                "enum": [
                  "quest",
                  "hunt",
                  "shop",
                  "collect",
                  "rest",
                  "explore",
                  "travel",
                  "idle",
                  "goto"
                ]
              },
              "map": {
                "type": "integer",
                "minimum": -1,
                "maximum": 10000
              },
              "mob": {
                "type": "integer",
                "minimum": -1,
                "maximum": 10000
              },
              "count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 30
              },
              "seconds": {
                "type": "integer",
                "minimum": 5,
                "maximum": 120
              },
              "x": {
                "type": "integer",
                "minimum": -1,
                "maximum": 20000
              },
              "y": {
                "type": "integer",
                "minimum": -1,
                "maximum": 20000
              }
            },
            "required": [
              "goal",
              "map",
              "mob",
              "count",
              "seconds",
              "x",
              "y"
            ]
          }
        }
      }
    }
  }
}